generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLISHER
  AICLIENT
}

enum AccessType {
  OPEN
  PAID
  BLOCKED
}

enum LicenseType {
  SUMMARY
  DISPLAY
}

enum ContentFormat {
  MARKDOWN
  JSON
}

enum SpendTokenStatus {
  ACTIVE
  SPENT
  EXPIRED
}

enum PriceRuleScope {
  BOT
  PAGE
  KEYWORD
  FRESHNESS
  DIRECTORY
  GLOBAL
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  role         Role
  createdAt    DateTime   @default(now())
  publisher    Publisher?
  aiClient     AIClient?
}

model Publisher {
  id         Int               @id @default(autoincrement())
  userId     Int               @unique
  name       String
  user       User              @relation(fields: [userId], references: [id])
  domains    Domain[]
  readEvents ReadEvent[]
  balance    PublisherBalance?
  createdAt  DateTime          @default(now())
}

model AIClient {
  id           Int             @id @default(autoincrement())
  userId       Int             @unique
  name         String
  user         User            @relation(fields: [userId], references: [id])
  apiKeys      APIKey[]
  requests     RequestLog[]
  usages       UsageAggregate[]
  readEvents   ReadEvent[]
  clientBalance ClientBalance?
  agents       AgentIdentity[]
  mintedTokens SpendToken[]
  ledgerTransactions LedgerTransaction[]
  createdAt    DateTime        @default(now())
}

model Domain {
  id          Int              @id @default(autoincrement())
  publisherId Int
  name        String           @unique
  verified    Boolean          @default(false)
  verifyToken String           @default(uuid())
  publisher   Publisher        @relation(fields: [publisherId], references: [id])
  policies    AIPolicy[]
  requests    RequestLog[]
  usages      UsageAggregate[]
  readEvents  ReadEvent[]
  pricingRules PricingRule[]
  contentFilters ContentFilter[]
  licenses      License[]
  mintedTokens SpendToken[]
  ledgerTransactions LedgerTransaction[]
  webhooks      PublisherWebhook[]
  apiLogs       DomainApiLog[]
  subdomainCnameTarget String?
  subdomainHost String?
  verificationMethod String @default("DNS_TXT")
  createdAt   DateTime         @default(now())
}

model DomainApiLog {
  id         Int      @id @default(autoincrement())
  domainId   Int
  timestamp  DateTime @default(now())
  method     String?
  path       String
  url        String?
  statusCode Int?
  bytesSent  Int?
  userAgent  String?
  ipAddress  String?
  source     String?
  raw        Json?
  createdAt  DateTime @default(now())
  domain     Domain   @relation(fields: [domainId], references: [id])

  @@index([domainId, timestamp])
}

model AgentIdentity {
  id                 Int      @id @default(autoincrement())
  aiClientId         Int
  agentId            String
  allowedUserAgentRe String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  aiClient           AIClient @relation(fields: [aiClientId], references: [id])

  @@unique([aiClientId, agentId])
}

model PricingRule {
  id                Int            @id @default(autoincrement())
  domainId          Int
  scope             PriceRuleScope
  pathPattern       String?
  exactUrl          String?
  userAgentRegex    String?
  keywordExpression String?
  freshnessWindowMins Int?
  licenseType       LicenseType?
  licenseId         Int?
  priceMicros       Int
  priority          Int            @default(100)
  enabled           Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  domain            Domain         @relation(fields: [domainId], references: [id])
  license           License?       @relation(fields: [licenseId], references: [id])
}

model License {
  id           Int           @id @default(autoincrement())
  domainId     Int
  code         String
  terms        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  domain       Domain        @relation(fields: [domainId], references: [id])
  pricingRules PricingRule[]

  @@unique([domainId, code])
}

model ContentFilter {
  id               Int      @id @default(autoincrement())
  domainId         Int
  blockedPathRegex String?
  cssStripSelectors String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  domain           Domain   @relation(fields: [domainId], references: [id])
}

model SpendToken {
  id                String        @id @default(cuid())
  aiClientId        Int
  domainId          Int
  canonicalHost     String
  canonicalPath     String
  canonicalFullUrl  String
  licenseType       LicenseType
  format            ContentFormat
  userAgent         String
  agentIdentity     String?
  maxPriceMicros    Int?
  priceMicros       Int
  platformFeeMicros Int
  totalMicros       Int
  tokenHash         String        @unique
  expiresAt         DateTime
  spentAt           DateTime?
  status            SpendTokenStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  aiClient          AIClient      @relation(fields: [aiClientId], references: [id])
  domain            Domain        @relation(fields: [domainId], references: [id])
  ledgerTransaction LedgerTransaction?
}

model PublisherWebhook {
  id          Int      @id @default(autoincrement())
  domainId    Int
  url         String
  eventType   String
  secret      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  domain      Domain   @relation(fields: [domainId], references: [id])
}

model LedgerTransaction {
  id                    String        @id @default(cuid())
  aiClientId            Int
  domainId              Int
  tokenId               String?       @unique
  idempotencyKey        String        @unique
  source                String
  url                   String
  path                  String
  licenseType           LicenseType
  format                ContentFormat
  publisherAmountMicros Int
  platformFeeMicros     Int
  totalMicros           Int
  currency              String        @default("USD")
  matchedRuleId         Int?
  createdAt             DateTime      @default(now())
  aiClient              AIClient      @relation(fields: [aiClientId], references: [id])
  domain                Domain        @relation(fields: [domainId], references: [id])
  token                 SpendToken?   @relation(fields: [tokenId], references: [id])
}

model AIPolicy {
  id          Int      @id @default(autoincrement())
  domainId    Int
  pathPattern String
  allowAI     Boolean
  pricePer1k  Int
  maxRps      Int?
  updatedAt   DateTime @updatedAt
  accessType  AccessType @default(OPEN)
  priceMicros Int        @default(0)
  domain      Domain   @relation(fields: [domainId], references: [id])
}

model APIKey {
  id         Int              @id @default(autoincrement())
  aiClientId Int
  keyHash    String           @unique
  createdAt  DateTime         @default(now())
  revokedAt  DateTime?
  aiClient   AIClient         @relation(fields: [aiClientId], references: [id])
  requests   RequestLog[]
  usages     UsageAggregate[]
}

model RequestLog {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  domainId   Int
  aiClientId Int
  apiKeyId   Int?
  path       String
  bytesSent  Int
  statusCode Int
  domain     Domain   @relation(fields: [domainId], references: [id])
  aiClient   AIClient @relation(fields: [aiClientId], references: [id])
  apiKey     APIKey?  @relation(fields: [apiKeyId], references: [id])
}

model UsageAggregate {
  id          Int      @id @default(autoincrement())
  periodStart DateTime
  periodEnd   DateTime
  domainId    Int
  aiClientId  Int
  apiKeyId    Int?
  requests    Int
  bytes       Int
  chargeCents Int
  domain      Domain   @relation(fields: [domainId], references: [id])
  aiClient    AIClient @relation(fields: [aiClientId], references: [id])
  apiKey      APIKey?  @relation(fields: [apiKeyId], references: [id])
}

model ReadEvent {
  id          String     @id @default(cuid())
  aiClientId  Int
  publisherId Int
  domainId    Int
  url         String
  path        String
  pathPattern String?
  accessType  AccessType
  bytes       Int?
  priceMicros Int
  createdAt   DateTime   @default(now())
  aiClient    AIClient   @relation(fields: [aiClientId], references: [id])
  publisher   Publisher  @relation(fields: [publisherId], references: [id])
  domain      Domain     @relation(fields: [domainId], references: [id])
}

model PublisherBalance {
  publisherId   Int      @id
  balanceMicros Int      @default(0)
  updatedAt     DateTime @default(now())
  publisher     Publisher @relation(fields: [publisherId], references: [id])
}

model ClientBalance {
  clientId      Int      @id
  balanceMicros Int      @default(0)
  updatedAt     DateTime @default(now())
  aiClient      AIClient @relation(fields: [clientId], references: [id])
}
